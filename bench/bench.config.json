          "steadySeconds": 5,
          "preAllocatedVUs": 5,
          "maxVUs": 20
        },
        "rate-limited": {
          "rate": 3,
          "warmupSeconds": 2,
          "steadySeconds": 5,
          "preAllocatedVUs": 5,
          "maxVUs": 20,
          "rpm": 6
        },
        "chaos": {
          "rate": 5,
          "warmupSeconds": 2,
          "steadySeconds": 5,
          "preAllocatedVUs": 5,
          "maxVUs": 20
        }
      }
    }
  }
