    {
      "id": 6,
      "type": "timeseries",
      "title": "Request rate by status class",
      "description": "Admitted /v1 requests per second by operation and status class.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
