{
  "name": "switchyard",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted, OpenAI-compatible LLM gateway",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --import ./src/infra/telemetry/register.ts src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env --import ./src/infra/telemetry/register-worker.ts src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./dist/infra/telemetry/register.js dist/server.js",
    "typecheck": "tsc --noEmit",
    "check:grafana": "node --import tsx scripts/check-grafana.ts",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --coverage",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:grafana && pnpm test:coverage && pnpm build",
    "test:smoke": "node scripts/compose-smoke.ts --down",
    "demo:traffic": "node --import tsx scripts/demo-traffic.ts",
    "test:contract": "vitest run --project contract",
    "test:contract:py": "node --import tsx scripts/contract-python.ts",
    "bench": "node bench/run.ts",
    "bench:report": "node bench/report.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/db-migrate.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@biomejs/biome": "^2.5.15",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@testcontainers/redpanda": "12.2.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "openai": "^7.30.1",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "1.11.0",
    "@fastify/otel": "^0.21.2",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-ioredis": "^0.71.0",
    "@opentelemetry/instrumentation-pg": "^0.75.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "undici": "^8.11.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
