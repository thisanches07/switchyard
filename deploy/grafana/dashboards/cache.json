      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (team) (rate(switchyard_cache_savings_usd_total[$__rate_interval])) * 3600",
          "legendFormat": "{{team}}",
