#cloud-config
# Switchyard demo VM (spec 013, AC-9). Rendered by Terraform's templatefile(); the only
# variable is switchyard_version (scripts/render-cloud-init.ts renders it the same way for
# `cloud-init schema` in CI). No secret here: the operator copies
# /etc/switchyard/switchyard.env over SSH and a systemd path unit then starts the stack.

package_update: true
package_upgrade: true

# Docker Engine and the Compose plugin from Docker's apt repository.
apt:
  sources:
    docker.list:
      source: "deb [signed-by=$KEY_FILE] https://download.docker.com/linux/ubuntu $RELEASE stable"
      keyid: 9DC858229FC7DD38854AE2D88D81803C0EBFCD88
      keyserver: keyserver.ubuntu.com

packages:
  - ca-certificates
  - curl
  - docker-ce
  - docker-ce-cli
  - containerd.io
  - docker-buildx-plugin
  - docker-compose-plugin
  - unattended-upgrades

# SSH: key-only login (the key comes from the instance's ssh_authorized_keys metadata).
ssh_pwauth: false
disable_root: true

write_files:
  - path: /etc/ssh/sshd_config.d/60-switchyard.conf
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes

  # Automatic security updates.
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: "0644"
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      APT::Periodic::AutocleanInterval "7";

  # Installs deploy/compose/ and deploy/grafana/ (spec 011 dashboards) from the repository at
  # tag v<version> into /opt/switchyard/deploy. Keeps an existing compose/config/ so operator
  # edits survive upgrades.
  - path: /usr/local/bin/switchyard-fetch
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu
      if [ "$#" -ne 1 ]; then
        echo "usage: switchyard-fetch <version>   (e.g. 0.1.0)" >&2
        exit 2
      fi
      version="$1"
      url="https://codeload.github.com/thisanches07/switchyard/tar.gz/refs/tags/v$version"
      dir=/opt/switchyard/deploy
      tmp="$(mktemp -d)"
      trap 'rm -rf "$tmp"' EXIT
      curl -fsSL --retry 5 "$url" | tar -xz -C "$tmp" --strip-components=1 --wildcards '*/deploy/compose' '*/deploy/grafana'
      mkdir -p "$dir/compose/config"
      install -m 0644 "$tmp/deploy/compose/compose.yml" "$tmp/deploy/compose/Caddyfile" "$tmp/deploy/compose/switchyard.env.example" "$dir/compose/"
      for file in switchyard.yaml pricing.yaml; do
        if [ ! -e "$dir/compose/config/$file" ]; then
          install -m 0644 "$tmp/deploy/compose/config/$file" "$dir/compose/config/$file"
        fi
      done
      rm -rf "$dir/grafana"
      cp -R "$tmp/deploy/grafana" "$dir/grafana"
      chmod -R a+rX "$dir"
      echo "Switchyard deploy bundle v$version installed in $dir"

  - path: /etc/systemd/system/switchyard.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Switchyard (Docker Compose stack)
      Requires=docker.service
      After=docker.service network-online.target
      Wants=network-online.target
      ConditionPathExists=/etc/switchyard/switchyard.env

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=/opt/switchyard/deploy/compose
      ExecStart=/usr/bin/docker compose --env-file /etc/switchyard/switchyard.env -f compose.yml up -d --wait --wait-timeout 600
      ExecStop=/usr/bin/docker compose --env-file /etc/switchyard/switchyard.env -f compose.yml down
      TimeoutStartSec=900

      [Install]
      WantedBy=multi-user.target

  # Starts the stack as soon as the operator has copied the env file (and at every boot after).
  - path: /etc/systemd/system/switchyard.path
    permissions: "0644"
    content: |
      [Unit]
      Description=Start Switchyard once /etc/switchyard/switchyard.env exists

      [Path]
      PathExists=/etc/switchyard/switchyard.env
      Unit=switchyard.service

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl restart ssh
  # Oracle's Ubuntu images ship iptables rules that reject everything but SSH; allow 80/443.
  - iptables -I INPUT -p tcp -m multiport --dports 80,443 -m conntrack --ctstate NEW -j ACCEPT
  - if command -v netfilter-persistent >/dev/null 2>&1; then netfilter-persistent save; fi
  - install -d -m 0700 -o root -g root /etc/switchyard
  # Units first: if the download fails (e.g. the tag is not published yet), rerun
  # `sudo switchyard-fetch <version>` by hand and the path unit still starts the stack.
  - systemctl daemon-reload
  - systemctl enable --now docker.service switchyard.path
  - /usr/local/bin/switchyard-fetch ${switchyard_version}
