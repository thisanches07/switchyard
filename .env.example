# --- Gateway ---
PORT=8080
LOG_LEVEL=info
SWITCHYARD_CONFIG=config/switchyard.yaml
# Bearer token for /admin/*; the admin API is disabled when unset (generate: openssl rand -hex 32)
ADMIN_TOKEN=dev-only-admin-token-change-me
# Secret mixed into API key hashes, at least 32 chars (generate: openssl rand -hex 32).
# Back it up with the database: losing it invalidates every API key.
KEY_PEPPER=dev-only-pepper-change-me-0123456789abcdef
# Apply database migrations at startup (Compose sets true; production runs pnpm db:migrate)
MIGRATE_ON_BOOT=true

# --- Infrastructure (defaults match docker-compose.yml) ---
DATABASE_URL=postgres://switchyard:switchyard@localhost:55432/switchyard
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:19092
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=switchyard-gateway

# --- Providers (only the ones you use) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
