# --- Gateway ---
PORT=8080
LOG_LEVEL=info
SWITCHYARD_CONFIG=config/switchyard.yaml
# Bearer token for /admin/* (generate: openssl rand -hex 32)
ADMIN_TOKEN=change-me
# Secret mixed into API key hashes (generate: openssl rand -hex 32)
KEY_PEPPER=change-me

# --- Infrastructure (defaults match docker-compose.yml) ---
DATABASE_URL=postgres://switchyard:switchyard@localhost:55432/switchyard
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:19092
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=switchyard-gateway

# --- Providers (only the ones you use) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
