# Dependencies & builds
node_modules/
dist/
coverage/
*.tsbuildinfo

# Env & secrets
.env
.env.*
!.env.example

# Local config (copy from config/switchyard.example.yaml)
config/switchyard.yaml

# Benchmark smoke and dirty-tree runs (spec 012); clean full runs in bench/results/ are committed
bench/results/local/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Terraform (spec 013): state, working dirs and real variable values never get committed.
# The provider lock file (.terraform.lock.hcl) and *.tfvars.example are tracked.
**/.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfplan
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log

# Production environment files (spec 013); only *.env.example is tracked.
*.env
!*.env.example

# Personal planning notes (pt-BR), kept local only
PLANO_DO_PROJETO.md

# Claude Code local settings
.claude/settings.local.json

# Python contract tests
__pycache__/
.pytest_cache/
