# Production environment for deploy/compose/compose.yml (spec 013). Placeholders only.
# Copy to the VM as /etc/switchyard/switchyard.env (mode 600, owner root) as docs/deploy.md
# describes. Never commit the real file. The gateway refuses to start with the replace-me values.

# Image version to run (ghcr.io/thisanches07/switchyard-{gateway,worker}:<version>).
SWITCHYARD_VERSION=0.1.0

# Hostname for the TLS certificate. Default: the VM's public IP with dashes, on sslip.io
# (`terraform output demo_hostname`), or your own domain pointing at the VM.
SWITCHYARD_HOSTNAME=203-0-113-10.sslip.io

# Secrets: generate each one with `openssl rand -hex 32` (hex keeps them URL-safe).
ADMIN_TOKEN=replace-me-with-openssl-rand-hex-32
# Back KEY_PEPPER up with the database: losing it invalidates every API key.
KEY_PEPPER=replace-me-with-openssl-rand-hex-32
POSTGRES_PASSWORD=replace-me-with-openssl-rand-hex-32

LOG_LEVEL=info

# Optional hosted providers (only with provider-side spending limits, see docs/deploy.md).
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
