      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(switchyard_request_duration_seconds_count{status=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(switchyard_request_duration_seconds_count[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx of admitted requests",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(switchyard_requests_total{status=~\"5..|upstream_error_midstream\"}[$__rate_interval])) / clamp_min(sum(rate(switchyard_requests_total[$__rate_interval])), 1e-9)",
          "legendFormat": "upstream errors",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
